---
import Icon from "./Icon.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
const mainLinks = [
  { label: "Strona główna", href: "/" },
  ...site.nav
    .filter((i) => i.href)
    .map((i) => ({ label: i.label, href: i.href as string })),
  ...(site.privacy.ready ? [{ label: "Polityka prywatności", href: "/polityka-prywatnosci" }] : []),
];
const actionLinks = site.nav.find((i) => i.children)?.children ?? [];
const groups = [
  { title: "O kancelarii", links: mainLinks },
  { title: "Czynności", links: actionLinks },
];
---

<footer class="bg-primary text-primary-content">
  <div class="wrap grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      groups.map((g) => (
        <nav aria-label={g.title}>
          <h2 class="footer-title mb-2">{g.title}</h2>
          <ul class="space-y-1">
            {g.links.map((l) => (
              <li>
                <a class="link link-hover" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div>
      <h2 class="footer-title mb-2">Kontakt</h2>
      <ul class="space-y-1">
        {
          site.phones.map((p) => (
            <li>
              <a class="link link-hover inline-flex items-center gap-2" href={`tel:${p.tel}`}>
                <Icon name={p.kind === "mobile" ? "mobile" : "phone"} class="size-4" />
                {p.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="link link-hover inline-flex items-center gap-2" href={`mailto:${site.email}`}>
            <Icon name="mail" class="size-4" />
            {site.email}
          </a>
        </li>
        <li>
          <a
            class="link link-hover inline-flex items-center gap-2"
            href={site.facebook}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="facebook" class="size-4" />
            Facebook
          </a>
        </li>
      </ul>
    </div>

    <address class="not-italic">
      <h2 class="footer-title mb-2">Adres</h2>
      <p>{site.name}</p>
      <p>{site.address.street}</p>
      <p>{site.address.unit} ({site.address.floor})</p>
      <p>{site.address.zip} {site.address.city}</p>
      <p class="mt-3">NIP: {site.nip}</p>
      <p>REGON: {site.regon}</p>
    </address>
  </div>
  <div class="border-t border-primary-content/20 py-4 text-center text-sm">
    &copy; 2022–{year} {site.name}
  </div>
</footer>
