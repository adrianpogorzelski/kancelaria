---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<!-- Dolny pasek szybkiego kontaktu na telefonach. Stała wysokość (h-16 = 4rem). -->
<nav
  aria-label="Szybki kontakt"
  class="fixed inset-x-0 bottom-0 z-40 grid h-16 grid-cols-3 border-t bg-base-100 md:hidden"
>
  {
    site.phones.map((p) => (
      <a href={`tel:${p.tel}`} class="flex flex-col items-center justify-center gap-1 text-xs">
        <Icon name={p.kind === "mobile" ? "mobile" : "phone"} class="size-6 text-primary" />
        <span>{p.name}</span>
      </a>
    ))
  }
  <a href={`mailto:${site.email}`} class="flex flex-col items-center justify-center gap-1 text-xs">
    <Icon name="mail" class="size-6 text-primary" />
    <span>E-mail</span>
  </a>
</nav>