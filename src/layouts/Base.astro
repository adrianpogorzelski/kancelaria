---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCallBar from "../components/MobileCallBar.astro";
import { site } from "../data/site";
import { cleanPath } from "../lib/url";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image = "/img/budynek.webp", noindex = false } = Astro.props;

const path = cleanPath(Astro.url.pathname);
const canonical = `${site.url}${path}`;
const ogImage = `${site.url}${image}`;
---

<!doctype html>
<html lang="pl" data-theme="kancelaria">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/img/AW.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-base-100 text-base-content">
    <a
      href="#tresc"
      class="btn btn-primary sr-only z-[100] focus:not-sr-only focus:absolute focus:left-2 focus:top-2"
    >
      Przejdź do treści
    </a>
    <Header />
    <main id="tresc" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>
