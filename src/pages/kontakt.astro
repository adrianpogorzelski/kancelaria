---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import MapEmbed from "../components/MapEmbed.astro";
import LocalBusinessJsonLd from "../components/LocalBusinessJsonLd.astro";
import { site } from "../data/site";
---

<Base
  title="Kontakt z kancelarią – Kancelaria Notarialna Anna Wawszczak, Opole"
  description="Dane kontaktowe, godziny otwarcia, formularz i dojazd do kancelarii notarialnej Anny Wawszczak w Opolu-Zaodrzu, ul. Spychalskiego 13."
>
  <LocalBusinessJsonLd slot="head" />

  <div class="wrap pb-10">
    <Breadcrumbs current="Kontakt" />

    <h1 class="border-b pb-3 text-5xl">Kontakt</h1>

    <div class="grid gap-8 py-6 md:grid-cols-2">
      <section>
        <h2 class="text-3xl font-bold">{site.name}</h2>

        <address class="flex items-start gap-2 py-4 not-italic">
          <Icon name="pin" class="mt-1 size-5 shrink-0" />
          <span>
            {site.address.street}, {site.address.unit}, {site.address.zip} {site.address.city}
          </span>
        </address>

        <ul class="space-y-2 pb-4">
          {
            site.phones.map((p) => (
              <li>
                <a href={`tel:${p.tel}`} class="inline-flex items-center gap-2 hover:underline">
                  <Icon name={p.kind === "mobile" ? "mobile" : "phone"} />
                  {p.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:underline">
              <Icon name="mail" />
              {site.email}
            </a>
          </li>
        </ul>

        <p>NIP: {site.nip}</p>
        <p>REGON: {site.regon}</p>

        <h2 class="mt-6 text-xl font-bold">Godziny otwarcia</h2>
        <p class="mt-2">
          Kancelaria czynna jest <b>{site.hours.text}</b> w godzinach <b>{site.hours.range}</b>.
        </p>
        <h3 class="mt-4 text-xl">Indywidualne terminy</h3>
        <p class="mt-1">
          Skontaktuj się z kancelarią, aby umówić indywidualny termin poza godzinami, w których pracuje
          notariusz: sobota, wczesne godziny poranne lub późne popołudniowe.
        </p>
      </section>

      <section class="card border shadow-xl" aria-labelledby="formularz-tytul">
        <div class="card-body">
          <h2 id="formularz-tytul" class="card-title">Formularz kontaktowy</h2>

          <!-- Netlify Forms: nazwa formularza i nazwy pól bez zmian względem obecnej strony. -->
          <form
            name="formularz"
            method="POST"
            action="/dziekujemy"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-3"
          >
            <input type="hidden" name="form-name" value="formularz" />
            <p class="hidden">
              <label>Nie wypełniaj tego pola: <input name="bot-field" /></label>
            </p>

            <div class="fieldset">
              <label class="label" for="name">Imię</label>
              <input id="name" type="text" name="Imię" autocomplete="name" placeholder="Podaj imię..." class="input input-primary w-full" required />
            </div>

            <div class="fieldset">
              <label class="label" for="email">Adres e-mail</label>
              <input id="email" type="email" name="E-mail" autocomplete="email" placeholder="Podaj swój adres e-mail..." class="input input-primary w-full" required />
            </div>

            <div class="fieldset">
              <label class="label" for="phone">Numer telefonu</label>
              <input id="phone" type="tel" name="Numer telefonu" autocomplete="tel" placeholder="Podaj swój numer telefonu..." class="input input-primary w-full" />
            </div>

            <label class="flex cursor-pointer items-center gap-3">
              <input type="checkbox" name="Kontakt telefoniczny" class="toggle toggle-primary" />
              <span>Proszę o kontakt telefoniczny</span>
            </label>

            <div class="fieldset">
              <label class="label" for="message">Treść wiadomości</label>
              <textarea id="message" name="Wiadomość" placeholder="Wpisz treść wiadomości..." class="textarea textarea-primary h-28 w-full" required></textarea>
            </div>

            <label class="flex cursor-pointer items-start gap-3 text-sm">
              <input type="checkbox" name="Zgoda RODO" class="toggle toggle-primary mt-0.5 shrink-0" required />
              <span>
                Zgadzam się na przetwarzanie danych osobowych podanych w formularzu przez Kancelarię
                Notarialną Anny Wawszczak w celu kontaktu i przygotowania do przeprowadzenia czynności
                notarialnej.
                {site.privacy.ready && (
                  <>
                    {" "}
                    Szczegóły w <a class="link" href="/polityka-prywatnosci">polityce prywatności</a>.
                  </>
                )}
              </span>
            </label>

            <div class="pt-2 text-center">
              <button type="submit" class="btn btn-primary btn-wide">Wyślij</button>
            </div>
          </form>
        </div>
      </section>
    </div>

    <section id="dojazd" class="scroll-mt-32 py-6">
      <h2 class="divider text-3xl font-bold">Dojazd</h2>
      <p class="py-3">
        Kancelaria notarialna Anny Wawszczak jest zlokalizowana na opolskim Zaodrzu, przy ulicy
        Stanisława Spychalskiego. W pobliżu zbiegają się ulica Wrocławska i plac Piłsudskiego.
      </p>

      <MapEmbed />

      <p class="py-3">
        Dojazd od centrum Opola możliwy jest przez Most Piastowski, przy którym krzyżują się ulice
        Piastowska i Katedralna. Dojazd od zachodniej strony, z dzielnic Zaodrze, Szczepanowice, osiedla
        Dambonia oraz okolicznych miejscowości (Chmielowice, Chróścina, Mechnice itd.), umożliwia ulica
        Niemodlińska i Most Zaodrzański.
      </p>

      <h3 class="pt-2 text-xl font-bold">Parkingi</h3>
      <p class="pb-3">
        W pobliżu kancelarii <b>nie obowiązuje strefa płatnego parkowania</b>, miejsca postojowe znajdują
        się w bezpośrednim pobliżu biurowca.
      </p>

      <h3 class="pt-2 text-xl font-bold">Komunikacja miejska</h3>
      <p>
        Bezpośrednio przed wejściem do kancelarii znajduje się
        <strong>przystanek autobusowy {site.transport.stop}</strong> (nr {site.transport.stopNumbers}).
        Dojazd jest możliwy liniami:
      </p>
      <ul class="flex flex-wrap gap-2 py-3" aria-label="Linie autobusowe">
        {site.transport.lines.map((l) => <li class="badge badge-neutral">{l}</li>)}
      </ul>
      <p>
        <a href={site.transport.planner} target="_blank" rel="noopener noreferrer" class="link">
          Sprawdź dojazd komunikacją miejską
        </a>
      </p>
    </section>
  </div>
</Base>
